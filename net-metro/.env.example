# NETMETRO - Variables de entorno para el despliegue en GitHub Pages
#
# Este archivo SÍ se sube al repositorio (es solo la plantilla, sin valores reales).
# Copialo como ".env" si quieres tenerlas documentadas en tu máquina, pero recuerda que
# el navegador NO puede leer archivos .env: las claves reales solo se usan en dos lugares:
#
#   1. Local: src/config/supabaseConfig.js (ver supabaseConfig.example.js)
#   2. Producción: Secrets del repositorio en GitHub (Settings -> Secrets and variables ->
#      Actions), que el workflow .github/workflows/deploy.yml usa para generar ese mismo
#      archivo automáticamente antes de publicar.

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
